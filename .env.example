# Atlas Scene configuration. Copy to .env and edit.

# ─────────────────────────────────────────────────────────────────────────────
# 3ds Max bridge port.
#
# 9876 is taken by Houdini and 9877 by ZBrush and 9878 by Marvelous Designer on
# this machine. Do NOT "restore" this to 9876 — that is the upstream default
# every DCC bridge copy-pastes, and the second one to bind either fails or,
# worse, answers commands meant for the other application. When that happens the
# failure looks like a protocol bug inside the wrong DCC and costs hours.
#
# This value must agree in two places: here, and inside 3ds Max where the bridge
# reads the same variable.
ATLAS_MAX_PORT=9879

# ─────────────────────────────────────────────────────────────────────────────
# Raw MaxScript execution over the bridge.
#
# This is arbitrary code execution inside 3ds Max. It is needed for building
# option structs that pymxs cannot express, so it cannot be removed outright,
# but it stays opt-in. Set to 1 in the environment *before* launching Max.
ATLAS_ALLOW_MAXSCRIPT=0

# ─────────────────────────────────────────────────────────────────────────────
# Overpass (OpenStreetMap building footprints).
#
# The public instance is rate-limited and shared. For anything beyond occasional
# use, run your own: https://github.com/drolbr/Overpass-API
ATLAS_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Open-Meteo historical weather (ERA5).
#
# The DATA is CC BY 4.0 and fine commercially with attribution. The free public
# ENDPOINT is limited to non-commercial use at ~10k calls/day — for production,
# self-host (the server is AGPLv3) or use their commercial tier, and point this
# at your own instance.
ATLAS_OPENMETEO_URL=https://archive-api.open-meteo.com/v1/archive

# ─────────────────────────────────────────────────────────────────────────────
# Photogrammetry backend. One of: meshroom | colmap | realitycapture
#
# SLAM3R is deliberately absent: it is CC BY-NC-SA 4.0 (as are its DUSt3R-derived
# weights) and cannot be used for commercial delivery. Meshroom/AliceVision is
# MPL-2.0 and also does UV unwrap and texture baking, which SLAM3R does not.
ATLAS_RECON_BACKEND=meshroom
ATLAS_MESHROOM_BIN=
ATLAS_FFMPEG_BIN=ffmpeg
